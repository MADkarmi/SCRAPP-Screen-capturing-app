@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="section-name max-w-xl pl-20">@ViewData["Title"]</div>
<div class="grid grid-cols-12 p-10">
    <div class="col-span-12 md:col-span-4">
        <section class="flex flex-col">
            <form id="account" method="post">
                <div class="mx-3 px-3">Use a local account to log in.</div>
                <div asp-validation-summary="ModelOnly"
                     class="text-danger"
                     role="alert">
                </div>
                <div class="form-group">
                    <input asp-for="Input.Email"
                           class="peer form-control"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="name@example.com" />
                    <label asp-for="Input.Email"
                           class="peer form-label">
                        Email
                    </label>
                    <span asp-validation-for="Input.Email"
                          class="text-danger">
                    </span>
                </div>
                <div class="form-group">
                    <input asp-for="Input.Password"
                           class="form-control"
                           autocomplete="current-password"
                           aria-required="true"
                           placeholder="password" />
                    <label asp-for="Input.Password"
                           class="form-label">
                        Password
                    </label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-checkbox">
                    <label asp-for="Input.RememberMe" class="form-checkbox-label">
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                        <input type="checkbox" class="checkbox" asp-for="Input.RememberMe" />                        
                    </label>                    
                </div>
                <div>
                    <button id="login-submit" type="submit" class="form-button-casual">Log in</button>
                </div>
                <div class="flex flex-col">
                    <a id="forgot-password"
                       asp-page="./ForgotPassword"
                       class="redirect-btn">
                        Forgot your password?
                    </a>
                    <a asp-page="./Register"
                       asp-route-returnUrl="@Model.ReturnUrl"
                        class="redirect-btn">
                        Register as a new user
                    </a>
                    <a id="resend-confirmation"
                       asp-page="./ResendEmailConfirmation"
                       class="redirect-btn">
                        Resend email confirmation
                    </a>

                </div>
            </form>
        </section>
    </div>
    <div class="col-span-12 md:col-span-6 md:col-start-7">
        <section>
            <h3>Use another service to log in.</h3>
            <hr />
            @{
                if ((Model.ExternalLogins?.Count ?? 0) == 0)
                {
                    <div>
                        <p>
                            Right now there are no external authentication services configured.
                        </p>
                    </div>
                }
                else
                {
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                        <div>
                            <p>
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit" class="btn-primary" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                                }
                            </p>
                        </div>
                    </form>
                }
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
