import { StyleMetrics, VerticalBox, ListView, Palette} from "std-widgets.slint";

export enum DeviceType {
    AudioInput,
    AudioOutput,
    MonitorOutput,
    WindowOutput,
}

export struct RecordingSource {
    title: string,
    isActive: bool,
    deviceId: int,
    deviceType: DeviceType,
}

export enum SelectionMode {
    Single,
    Multiple,
}

component SourcesListItem inherits Rectangle {
    in property <bool> enabled;
    in property <bool> selected;
    in property <bool> has-focus;
    in property <DeviceType> deviceType;
    in-out property <string> text <=> label.text;

    callback clicked <=> touch.clicked;

    min-height: l.preferred-height;

    states [
        pressed when touch.pressed : {
            state.opacity: 0.4;
        }
        hover when touch.has-hover : {
            state.opacity: 0.2;
        }
        selected when root.selected : {
            state.opacity: 0.5;
        }
        focused when root.has-focus : {
            state.opacity: 0.4;
        }
    ]

    state := Rectangle {
        opacity: 0;
        background: grey;
    }

    l := HorizontalLayout {
        y: (parent.height - self.height) / 2;
        padding: StyleMetrics.layout-padding;
        spacing: 5px;

        visibility_icon := Image{
            height: 20px;
            width: 20px;
            source: root.selected? @image-url("../icons/visible.png") : @image-url("../icons/notvisible.png");
            colorize: grey;
        }

        device_icon := Image{
            height: 20px;
            width: 20px;
            source: root.deviceType == DeviceType.AudioInput ? @image-url("../icons/microphone-black-shape.png") :
                    root.deviceType == DeviceType.AudioOutput ? @image-url("../icons/speaker-filled-audio-tool.png") :
                    root.deviceType == DeviceType.MonitorOutput ? @image-url("../icons/monitor.png") :
                    @image-url("../icons/window.png");
            colorize: grey;
        }

        label := Text {
            color: Palette.foreground;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-alignment: left;
            //text-overflow: elide;
            //width: parent.width - icon.width - 3 * StyleMetrics.layout-padding - spacing;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
    }
}

export component RecordingSourcePicker inherits VerticalBox {
    in property <bool> changeEnabled;
    in property <[RecordingSource]> sourceListModel;
    in property <string> label;
    in property <SelectionMode> selectionMode;
    callback on-source-selected(RecordingSource);

    VerticalBox { //source picker
        Text {
            horizontal-alignment: center;
            text: label;
            font-size: 15px;
        }

        Rectangle {
            min-width: 200px;
            background: Palette.background.darker(0.2);
            sourcesChoice := ListView {
                for source in root.sourceListModel: VerticalLayout{
                    SourcesListItem{
                        enabled: root.changeEnabled;
                        text: source.title;
                        selected: source.isActive;
                        deviceType: source.deviceType;
                        clicked => {
                            root.on-source-selected(source);
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: gray;
                    }
                }
            }

        }

    }

}