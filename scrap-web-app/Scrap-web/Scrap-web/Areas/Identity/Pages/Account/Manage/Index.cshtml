@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;    
}

<div class="section-name max-w-xl">@ViewData["Title"]</div>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="mt-6 w-full max-w-xl">
    <form id="profile-form" method="post">
        <div asp-validation-summary="ModelOnly"
                class="mb-3 w-full px-2 text-danger md:w-1/2"
                role="alert">
        </div>
        <div class="form-group">
            <input asp-for="Username"
                    class="peer form-control"
                    placeholder="Please choose your username."
                    disabled />
            <label asp-for="Username" class="form-label"></label>
        </div>
        <div class="form-group">
            <input asp-for="Input.PhoneNumber"
                id="phone"
                class="peer form-control hover:bg-background"                       
                placeholder="Please enter your phone number." />
            <label asp-for="Input.PhoneNumber" class="form-label"></label>
            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
        </div>
        <button id="update-profile-button"
                type="submit"
                class="form-button">
            Save
        </button>


    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.addEventListener('load', () => {
        const phoneInput = document.querySelector('#phone');
          phoneInput.addEventListener('keydown', disallowNonNumericInput);
          phoneInput.addEventListener('keyup', formatToPhone);
        });

        const disallowNonNumericInput = (evt) => {
          if (evt.ctrlKey) { return; }
          if (evt.key.length > 1) { return; }
          if (/[0-9.]/.test(evt.key)) { return; }
          evt.preventDefault();
        }

        const formatToPhone = (evt) => {
          const digits = evt.target.value.replace(/\D/g,'').substring(0,9);
          const areaCode = digits.substring(0,3);
          const prefix = digits.substring(3,6);
          const suffix = digits.substring(6,9);

          if(digits.length > 6) {evt.target.value = `${areaCode} - ${prefix} - ${suffix}`;}
          else if(digits.length > 3) {evt.target.value = `(${areaCode}) ${prefix}`;}
          else if(digits.length > 0) {evt.target.value = `(${areaCode}`;}
        };
    </script>
}
