@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="section-name max-w-xl">@ViewData["Title"]</div>
<div class="section-name max-w-xl">Enter your email:</div>
<div class="mt-6 w-full max-w-xl">
    <form method="post">
        <div asp-validation-summary="ModelOnly"
             class="text-danger"
             role="alert">
        </div>
        <div class="form-group">
            <input asp-for="Input.Email"
                   class="form-control"
                   autocomplete="username"
                   aria-required="true"
                   placeholder="name@example.com" />
            <label asp-for="Input.Email"
                   class="form-label">
            </label>
            <span asp-validation-for="Input.Email"
                  class="text-danger">
            </span>
        </div>
        <button type="submit" class="form-button">Reset Password</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
