OAUTH_AUTHORIZATION_ENDPOINT=**your application URL**/connect/authorize #to be changed to the actual authorization endpoint of your application
OAUTH_TOKEN_ENDPOINT=**your application URL**/connect/token #to be changed to the actual token endpoint of your application
OAUTH_CLIENT_ID=scrap-desktop-app
OAUTH_REDIRECT_URI=**your application RedirectUri**/callback #to be changed to the actual redirect URI port of your application
OAUTH_LOGOUT_ENDPOINT=**your application URL**/connect/logout #to be changed to the actual logout endpoint of your application
OAUTH_POST_LOGOUT_REDIRECT_URI=**your application PostLogoutRedirectUri**/logout-callback #to be changed to the actual post-logout redirect URI of application
OAUTH_REVOCATION_ENDPOINT=**your application URL**/connect/revoke #to be changed to the actual revocation endpoint of your application
UPLOAD_API_ENDPOINT=**your application URL**/api/uploads #to be changed to the actual upload API endpoint of your application
UPLOAD_RAW_API_ENDPOINT=stream
UPLOAD_MULTIPART_API_ENDPOINT=multipart
UPLOAD_CHUNKED_API_ENDPOINT=chunks
UPLOAD_COMPLETE_API_ENDPOINT=complete
DEFAULT_CHUNK_SIZE=52428800 # 50MB 26214400 # 25MB #104857600 # 10MB
MAX_CONCURRENT_CHUNKS=10 # Limit the number of concurrent chunk uploads