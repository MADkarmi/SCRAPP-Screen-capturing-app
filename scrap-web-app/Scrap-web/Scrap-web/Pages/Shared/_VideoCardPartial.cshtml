@model Models.Videos.VideoCardViewModel

<div class="min-w-[400px] basis-12 overflow-hidden rounded-lg border border-border bg-background-distinct p-4 hover:outline-2">
    <!-- Thumbnail -->
    <a asp-page="/Videos/Watch"
        asp-route-id="@Model.VideoId"
        class="rounded-lg bg-white">
        
        <div class="aspect-video overflow-hidden rounded-lg bg-background-distinct">
            @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
            {
                <img src="@Model.ThumbnailUrl"
                     alt="@Model.Title"
                     class="h-full w-full object-cover transition-transform duration-200 group-hover:scale-105" />
            }
            else
            {
                <div class="flex h-full w-full items-center justify-center">
                    <svg class="h-12 w-12 text-primary"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="1.5"
                              d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                </div>
            }
        
        </div>
    </a>

    <!-- Video information -->
    <div class="mt-3">
        <h3 class="line-clamp-2 flex items-center text-sm leading-5 font-semibold text-primary">
            <a asp-page="/Videos/Watch"
               asp-route-id="@Model.VideoId"
               class="text-lg font-semibold text-second">
                @Model.Title
            </a>
        </h3>        
        <div class="mt-1.5 text-sm text-primary">
            <a href="#" class="hover:text-second">
                @Model.UploaderName
            </a>

            <span class="mx-1">•</span>

            <time datetime="@Model.UploadDate.ToString("O")">
                @Model.UploadDate.ToString("MMM d, yyyy")
            </time>
        </div>
    </div>
</div>