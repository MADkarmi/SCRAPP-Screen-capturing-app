<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId><!--Your User Secrets ID--></UserSecretsId>
    <RootNamespace>Scrap_web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="8.0.29" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.29" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="8.0.29" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.29" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.29">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="8.0.23" />
    <PackageReference Include="OpenIddict.AspNetCore" Version="5.8.0" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="5.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scrap-web.ServiceDefaults\Scrap-web.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <UpToDateCheckBuilt Include="wwwroot/css/site.css" Set="Css" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="FileStorage\uploads\" />
    <Folder Include="FileStorage\videos\" />
    <Folder Include="wwwroot\Storage\" />
  </ItemGroup>
  <Target Name="Tailwind" BeforeTargets="Build;PrepareForPublish">
    <Exec Command="npm install" />
    <Exec Command="npx tailwindcss -i wwwroot/css/site.css -o wwwroot/css/site.min.css --minify" />
    <ItemGroup>
      <Content Include="wwwroot/css/site.min.css" CopyToOutputDirectory="Always" />
    </ItemGroup>
  </Target>

</Project>
